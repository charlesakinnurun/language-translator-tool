# ---------------------------------------------------------------------------
# Frontend environment template. Copy to `.env` if you need to override the
# API base URL. NOTE: only VITE_-prefixed variables are exposed to the
# browser bundle, so never place secrets here.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Leave empty in local development to use the
# Vite dev-server proxy (/api -> http://127.0.0.1:8000).
# For a separately hosted backend, e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=