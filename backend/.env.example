# ---------------------------------------------------------------------------
# Language Translation Tool - Backend environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Translation provider --------------------------------------------------
# "google" calls the Google Cloud Translation API.
# "mock"    runs fully offline with canned responses (no credentials needed).
TRANSLATION_PROVIDER=google

# Required when TRANSLATION_PROVIDER=google.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to a Google service-account key file (Application Default Credentials).
#   macOS/Linux:  GOOGLE_APPLICATION_CREDENTIALS=$(pwd)/keys/translation-service-account.json
#   Windows:      GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\translation-service-account.json
# Alternatively authenticate once via:
#   gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=

TRANSLATION_LOCATION=global
# Timeout (seconds) for each call to the translation API.
TRANSLATE_TIMEOUT_SECONDS=10.0

# --- Input constraints -----------------------------------------------------
# Maximum length of the text submitted for translation.
MAX_TEXT_LENGTH=5000
DEFAULT_SOURCE_LANGUAGE=en

# --- HTTP / CORS -----------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---------------------------------------------------------
# In-process sliding-window limiter (replace with Redis for multi-instance).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60